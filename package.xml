<?xml version="1.0"?>
<package format="2">
  <name>movesense_x95_ros</name>
  <version>0.1.0</version>
  <description>ROS 1 (Noetic) driver for the MoveSense X95-series stereo depth camera (stereo / depth / color / IMU / YOLO detections).</description>

  <maintainer email="legal@manplus-ai.com">Humanplus</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <build_depend>libopencv-dev</build_depend>
  <exec_depend>libopencv-dev</exec_depend>

  <!-- external (not rosdep-resolvable): MoveSense_X95_SDK, install it first (see README) -->
</package>
